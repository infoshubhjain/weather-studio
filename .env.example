# Weather Studio — optional configuration.
#
# THE APP RUNS FULLY WITHOUT THIS FILE. Every core feature (search, forecast,
# CRUD, exports, maps, Wikipedia, country data) uses keyless APIs. Everything
# below is an upgrade; each one degrades gracefully when absent.
#
#   cp .env.example .env.local   and fill in whichever you have.
#
# SECURITY: every variable here is read only inside server-side route handlers,
# so none of them reach the browser. Never rename one to NEXT_PUBLIC_* — that
# prefix inlines the value into the client bundle, where any visitor can read it.
# .env.local is gitignored; keep it that way.

# ─── AI natural-language search ──────────────────────────────────────────────
# Turns "is it beach weather in Barcelona this weekend?" into a structured query.
# Works with ANY OpenAI-compatible endpoint — set the base URL to switch provider
# with no code change.
#
#   Cerebras (recommended free tier — 30 RPM, 60k TPM, 14.4k/day, no card):
#     AI_BASE_URL=https://api.cerebras.ai/v1        AI_MODEL=llama-3.3-70b
#   Groq (fast, no card — note the 6k TPM ceiling):
#     AI_BASE_URL=https://api.groq.com/openai/v1    AI_MODEL=llama-3.3-70b-versatile
#   OpenAI:
#     AI_BASE_URL=https://api.openai.com/v1         AI_MODEL=gpt-4o-mini
#
# Without AI_API_KEY the ask box simply doesn't render and the normal search
# box handles everything.
AI_API_KEY=
AI_BASE_URL=https://api.cerebras.ai/v1
AI_MODEL=llama-3.3-70b

# ─── Database ────────────────────────────────────────────────────────────────
# Local development needs nothing — it writes ./data/weather.db automatically.
#
# SET THESE BEFORE DEPLOYING TO A SERVERLESS HOST. Vercel/Netlify have an
# ephemeral filesystem: a local SQLite file is wiped on every cold start and is
# not shared between instances, so saved records silently disappear. Turso is
# hosted libSQL with the same SQL dialect — free tier at turso.tech.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Override the local SQLite path (default ./data/weather.db).
# WEATHER_DB=./data/weather.db

# ─── Discover tab upgrades ───────────────────────────────────────────────────
# Turns the YouTube panel from search links into embedded videos.
# console.cloud.google.com → enable "YouTube Data API v3".
# Note the quota: search.list costs 100 units of a 10,000/day allowance,
# so this is ~100 searches per day.
YOUTUBE_API_KEY=

# Swaps the OpenStreetMap embed for a Google Maps embed.
# console.cloud.google.com → enable "Maps Embed API" (free, unmetered).
GOOGLE_MAPS_API_KEY=
