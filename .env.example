# Everything works with NO keys at all. These are optional upgrades.
# Copy to .env.local and fill in whichever you have.

# Turns the Discover tab's YouTube panel from search links into embedded videos.
# Get one at https://console.cloud.google.com -> enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# Swaps the OpenStreetMap embed for a Google Maps embed.
# https://console.cloud.google.com -> enable "Maps Embed API".
GOOGLE_MAPS_API_KEY=

# Where the SQLite file lives. Defaults to ./data/weather.db
# WEATHER_DB=./data/weather.db
